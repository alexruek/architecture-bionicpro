<mxfile host="Electron" type="device">
  <diagram id="bionicpro-c4-security" name="C4 Containers - Security">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="&lt;font style=&quot;font-size: 20px&quot;&gt;BionicPRO. Диаграмма контейнеров: управление учетными данными&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Вход через Keycloak с PKCE и OTP, токены только на сервере bionicpro-auth, учетные записи представительств в каталоге своей страны&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;">
          <mxGeometry x="40" y="10" width="1200" height="60" as="geometry" />
        </mxCell>
        <object id="b-ru" label="&lt;font style=&quot;font-size: 13px&quot;&gt;BionicPRO&lt;/font&gt;&lt;br&gt;[Программная система, контур в России]" c4Type="Boundary">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=8 4;arcSize=3;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;connectable=0;" vertex="1" parent="1">
            <mxGeometry x="40" y="330" width="1240" height="560" as="geometry" />
          </mxCell>
        </object>
        <object id="b-branch" label="&lt;font style=&quot;font-size: 13px&quot;&gt;Представительство BionicPRO&lt;/font&gt;&lt;br&gt;[Контур в стране представительства]" c4Type="Boundary">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;dashed=1;dashPattern=8 4;arcSize=3;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;connectable=0;" vertex="1" parent="1">
            <mxGeometry x="1340" y="330" width="380" height="230" as="geometry" />
          </mxCell>
        </object>
        <object id="person" label="&lt;font style=&quot;font-size: 14px&quot;&gt;Пользователь&lt;/font&gt;&lt;br&gt;[Пользователь]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Пилот протеза в России или в стране представительства&lt;/font&gt;" c4Type="Person">
          <mxCell style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=11;labelBackgroundColor=none;fillColor=#083F75;fontColor=#ffffff;align=center;strokeColor=#06315C;" vertex="1" parent="1">
            <mxGeometry x="550" y="90" width="200" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="frontend" label="&lt;font style=&quot;font-size: 14px&quot;&gt;Веб-приложение отчетов&lt;/font&gt;&lt;br&gt;[Контейнер: React, Nginx]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;SPA без токенов. Запросы /auth и /api на тот же origin, браузер прикладывает cookie сессии&lt;/font&gt;" c4Type="Container" c4Status="changed">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;strokeColor=#F59F00;strokeWidth=3;" vertex="1" parent="1">
            <mxGeometry x="80" y="380" width="260" height="150" as="geometry" />
          </mxCell>
        </object>
        <object id="auth" label="&lt;font style=&quot;font-size: 14px&quot;&gt;bionicpro-auth&lt;/font&gt;&lt;br&gt;[Контейнер: Python, FastAPI]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Authorization Code + PKCE, хранение токенов, сессия с ротацией id, обновление access_token, прокси к API&lt;/font&gt;" c4Type="Container" c4Status="new">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;strokeColor=#E8590C;strokeWidth=3;" vertex="1" parent="1">
            <mxGeometry x="520" y="380" width="260" height="150" as="geometry" />
          </mxCell>
        </object>
        <object id="keycloak" label="&lt;font style=&quot;font-size: 14px&quot;&gt;Keycloak&lt;/font&gt;&lt;br&gt;[Контейнер: Keycloak 21]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Единая точка входа и брокер IdP: PKCE S256, обязательный OTP, согласие, LDAP-федерация, роли&lt;/font&gt;" c4Type="Container" c4Status="changed">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;strokeColor=#F59F00;strokeWidth=3;" vertex="1" parent="1">
            <mxGeometry x="960" y="380" width="260" height="150" as="geometry" />
          </mxCell>
        </object>
        <object id="reports" label="&lt;font style=&quot;font-size: 14px&quot;&gt;Reports API&lt;/font&gt;&lt;br&gt;[Контейнер: Бэкенд, задание 2]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Принимает только запросы с access_token, проверяет подпись по JWKS&lt;/font&gt;" c4Type="Container">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#0E7DAD;" vertex="1" parent="1">
            <mxGeometry x="80" y="640" width="260" height="140" as="geometry" />
          </mxCell>
        </object>
        <object id="redis" label="&lt;font style=&quot;font-size: 14px&quot;&gt;Хранилище сессий&lt;/font&gt;&lt;br&gt;[Контейнер: Redis]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Сессии по хешу id, зашифрованные access_token и refresh_token, TTL&lt;/font&gt;" c4Type="Database" c4Status="new">
          <mxCell style="shape=cylinder3;size=14;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;strokeColor=#E8590C;strokeWidth=3;" vertex="1" parent="1">
            <mxGeometry x="520" y="640" width="260" height="140" as="geometry" />
          </mxCell>
        </object>
        <object id="kcdb" label="&lt;font style=&quot;font-size: 14px&quot;&gt;БД Keycloak&lt;/font&gt;&lt;br&gt;[Контейнер: PostgreSQL]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Настройки realm, локальные учетные записи, OTP-секреты. ПДн представительств не хранит&lt;/font&gt;" c4Type="Database">
          <mxCell style="shape=cylinder3;size=14;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" vertex="1" parent="1">
            <mxGeometry x="960" y="640" width="260" height="140" as="geometry" />
          </mxCell>
        </object>
        <object id="ldap" label="&lt;font style=&quot;font-size: 14px&quot;&gt;Каталог представительства&lt;/font&gt;&lt;br&gt;[Контейнер: OpenLDAP]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Учетные записи и группы ролей. ПДн хранятся в стране представительства&lt;/font&gt;" c4Type="Database" c4Status="new">
          <mxCell style="shape=cylinder3;size=14;boundedLbl=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;strokeColor=#E8590C;strokeWidth=3;" vertex="1" parent="1">
            <mxGeometry x="1400" y="370" width="260" height="150" as="geometry" />
